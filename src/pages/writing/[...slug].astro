---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';

export async function getStaticPaths() {
  // Drafts are reachable in `npm run dev` so you can preview them,
  // but they never get a URL in production.
  const essays = await getCollection('essays', ({ data }) =>
    import.meta.env.PROD ? !data.draft : true
  );
  return essays.map((essay) => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

type Props = { essay: CollectionEntry<'essays'> };

const { essay } = Astro.props;
const { Content, headings } = await render(essay);

// The contents rail is generated from the rendered h2s, so it can never drift
// out of sync with the essay itself.
const contents = headings.filter((h) => h.depth === 2);

const published = essay.data.date.toLocaleDateString('en-GB', {
  month: 'long',
  year: 'numeric',
});

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: essay.data.title,
  description: essay.data.summary,
  datePublished: essay.data.date.toISOString(),
  inLanguage: 'en',
  author: { '@type': 'Person', name: site.name, url: site.url },
  publisher: { '@type': 'Person', name: site.name, url: site.url },
  mainEntityOfPage: new URL(`/writing/${essay.id}/`, site.url).href,
};
---

<Base
  title={`${essay.data.title} — ${site.name}`}
  description={essay.data.summary}
  ogType="article"
  schema={[articleSchema]}
>
  <main>
    <div id="top" class="section">
      <div class="wrap head">
        <a class="back" href="/writing/">← Writing</a>
        <h1>{essay.data.title}</h1>
        <p class="standfirst">{essay.data.summary}</p>
        <div class="meta">
          <span>{published}</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{essay.data.location}</span>
          <span class="dot" aria-hidden="true">·</span>
          <span>{essay.data.readingMinutes} min</span>
        </div>
      </div>
    </div>

    <div class="wrap body">
      <aside>
        <div class="group-head">Contents</div>
        <nav aria-label="Contents">
          {contents.map((h) => <a href={`#${h.slug}`}>{h.text}</a>)}
          {essay.data.notes.length > 0 && <a href="#notes">Notes</a>}
        </nav>
      </aside>

      <article>
        <Content />

        {
          essay.data.notes.length > 0 && (
            <div id="notes" class="notes">
              <div class="eyebrow">Notes</div>
              <ol>
                {essay.data.notes.map((note, i) => (
                  <li>
                    <span class="notes__n">{i + 1}</span>
                    <span set:html={note} />
                  </li>
                ))}
              </ol>
            </div>
          )
        }

        <div class="foot">
          <a href="#top">↑ Back to top</a>
          {
            /* Points at the PL landing page until the translated essays exist.
               Swap to `/pl/writing/${essay.id}/` when they do. */
            essay.data.languages.includes('PL') && (
              <span>
                Also in <a class="foot__lang" href="/pl/" hreflang="pl">Polski</a>
              </span>
            )
          }
        </div>
      </article>
    </div>
  </main>
</Base>

<style>
  /* --- Head --------------------------------------------------------------- */
  .head {
    padding-block: 76px 52px;
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 34px;
  }

  .back:hover {
    color: var(--ink-bright);
  }

  h1 {
    margin: 0;
    max-width: 22ch;
    font-size: var(--size-essay-title);
    line-height: 1.03;
    letter-spacing: -0.035em;
    font-weight: 600;
  }

  .standfirst {
    margin: 24px 0 0;
    max-width: 56ch;
    font-size: 20px;
    line-height: 1.45;
    color: var(--ink-muted);
  }

  .meta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    font-family: var(--font-mono);
    font-size: var(--nav-size);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .dot {
    color: var(--ink-dot);
  }

  /* --- Body layout -------------------------------------------------------- */
  .body {
    padding-block: 56px 40px;
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  aside {
    position: sticky;
    top: calc(var(--header-h) + 38px);
  }

  aside nav {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 16px;
  }

  aside nav a {
    font-size: 14.5px;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  aside nav a:hover {
    color: var(--ink-bright);
  }

  /* --- Prose -------------------------------------------------------------- */
  article {
    max-width: var(--prose);
    font-size: 18.5px;
    line-height: 1.72;
    color: var(--ink-body);
  }

  /* MDX turns the block's contents into a <p>, so style the child, not the
     wrapper — a <p> inside a <p> would be invalid HTML. */
  article :global(.lede p) {
    margin: 0 0 24px;
    font-size: 21px;
    line-height: 1.58;
    color: var(--ink);
  }

  article :global(p) {
    margin: 0 0 24px;
  }

  article :global(h2) {
    margin: 52px 0 18px;
    font-family: var(--font-sans);
    font-size: var(--size-h2);
    line-height: 1.25;
    letter-spacing: -0.022em;
    font-weight: 600;
    color: var(--ink-heading);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }

  article :global(blockquote) {
    margin: 34px 0;
    padding: 0 0 0 26px;
    border-left: 2px solid var(--rule-quote);
    font-size: 21px;
    line-height: 1.5;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  article :global(blockquote p) {
    margin: 0;
  }

  article :global(a) {
    border-bottom: 1px solid var(--rule-accent);
  }

  article :global(a:hover) {
    border-bottom-color: var(--ink-bright);
  }

  article :global(sup) {
    color: var(--ink);
    font-size: 12px;
  }

  article :global(em) {
    font-style: italic;
  }

  /* --- Notes -------------------------------------------------------------- */
  .notes {
    margin-top: 64px;
    padding-top: 26px;
    border-top: 1px solid var(--rule);
  }

  .notes .eyebrow {
    display: block;
    margin-bottom: 18px;
  }

  .notes ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .notes li {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .notes li:last-child {
    margin-bottom: 0;
  }

  .notes__n {
    font-family: var(--font-mono);
    font-size: 12px;
    flex: 0 0 auto;
  }

  /* --- Foot --------------------------------------------------------------- */
  .foot {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: space-between;
    gap: 20px;
    font-family: var(--font-mono);
    font-size: var(--nav-size);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  .foot a {
    color: var(--ink-faint);
    border-bottom: none;
  }

  .foot a:hover {
    color: var(--ink-bright);
  }

  .foot__lang {
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .head {
      padding-block: 48px 36px;
    }

    .body {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      padding-block: 32px 24px;
    }

    aside {
      position: static;
    }
  }
</style>
