---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Contact from '../components/Contact.astro';
import { personSchema } from '../data/person';
import { links } from '../data/site';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { month: 'short', year: 'numeric' });


---

<Base schema={[personSchema]} alternatePath="/pl/">
  <main id="main-content">
    <!-- ------------------------------------------------------------- HERO -->
    <Hero />

    <!-- ----------------------------------------------------------- THESIS -->
    <section class="section">
      <div class="wrap rail">
        <h2 class="rail__label">Thesis</h2>
        <div class="thesis">
          <p class="thesis__lead">I like being there for version one.</p>
          <p>
            I am an engineer, researcher, and founder. My work has taken me from Samsung Galaxy
            field tests and commercial LTE networks to technology consulting across Europe,
            the Middle East, and Africa. Today I run
            <a class="link-underline" href="/ventures/#cycommsec">CyCommSec</a> and build
            <a class="link-underline" href="/ventures/#fuseai">FuseAI</a>, applying large language
            models to penetration testing and vulnerability management.
          </p>
          <p class="last">
            My doctorate at WAT explored how machine learning can interpret auditory brainstem
            responses. That research became the starting point for
            <a class="link-underline" href="/ventures/#neurality">Neurality</a>. I still teach at
            WAT, AGH, and SGH, write for Forbes Poland, and work on the governance of AI as an
            ISO 42001 lead auditor. I work in Polish and English, from Warsaw.
          </p>
          <a class="cta" href="/about/">Full biography →</a>
        </div>
      </div>
    </section>

    <!-- ---------------------------------------------------------- WRITING -->
    <section class="section">
      <div class="wrap rail">
        <h2 class="rail__label">Writing</h2>
        <div>
          {
            essays.slice(0, 2).map((essay) => (
              <a class="essay-row" href={`/writing/${essay.id}/`}>
                <div class="essay-row__body">
                  <div class="essay-row__title">{essay.data.title}</div>
                  <div class="essay-row__summary">{essay.data.summary}</div>
                </div>
                <div class="essay-row__date">{fmt(essay.data.date)}</div>
              </a>
            ))
          }
          <div class="link-row">
            <a class="mono-link" href="/writing/">All writing →</a>
            <a class="mono-link" href={links.forbes} rel="noopener" target="_blank">
              Forbes Poland ↗
            </a>
            <a class="mono-link" href="/rss.xml">RSS</a>
          </div>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------- RESEARCH -->
    <section class="section">
      <div class="wrap rail">
        <h2 class="rail__label">Research</h2>
        <div>
          <div class="stats">
            <div class="stat">
              <div class="stat__n">ABR</div>
              <div class="stat__label">
                Auditory brainstem response — the signal at the centre of my doctoral research.
              </div>
            </div>
            <div class="stat">
              <div class="stat__n">2018</div>
              <div class="stat__label">
                Doctorate, Military University of Technology (WAT), Warsaw.
              </div>
            </div>
            <div class="stat">
              <div class="stat__n">3</div>
              <div class="stat__label">
                Universities where I lecture: WAT, AGH Kraków, SGH Warsaw.
              </div>
            </div>
          </div>

          <p class="research__note">
            My academic work is in biomedical signal processing — using machine learning to
            interpret neurological signals. The software it produced is still used in hearing
            diagnostics.
          </p>

          <div class="paper">
            <div class="paper__title">
              Classification of auditory brainstem response using wavelet decomposition and SVM
              network
            </div>
            <div class="paper__meta">
              Dobrowolski, Suchocki, Tomczykiewicz, Majda-Zdancewicz · Biocybernetics and
              Biomedical Engineering 36(2), 2016
            </div>
          </div>

          <div class="link-row">
            <a class="mono-link" href={links.scholar} rel="noopener" target="_blank">
              Google Scholar ↗
            </a>
            <a class="mono-link" href={links.ieee} rel="noopener" target="_blank">DOI ↗</a>
            <a class="mono-link" href="/about/#publications">All publications →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------- VENTURES -->
    <section class="section">
      <div class="wrap rail">
        <h2 class="rail__label">Ventures</h2>
        <div>
          <div class="cards">
            <a class="card" href="/ventures/#cycommsec">
              <div class="card__role">CEO, co-founder</div>
              <div class="card__name">CyCommSec</div>
              <div class="card__body">
                ISO 27001-certified offensive security, vulnerability management, and NIS2 / DORA
                compliance — built by practitioners for the people who carry the risk.
              </div>
              <div class="card__foot">About the company →</div>
            </a>
            <a class="card" href="/ventures/#fuseai">
              <div class="card__role">Creator</div>
              <div class="card__name">FuseAI</div>
              <div class="card__body">
                An autonomous, multi-agent penetration-testing platform powered by LLMs, designed
                to run on-premise for organizations that need full control of their data.
              </div>
              <div class="card__foot">About the platform →</div>
            </a>
            <a class="card" href="/ventures/#neurality">
              <div class="card__role">Founder</div>
              <div class="card__name">Neurality</div>
              <div class="card__body">
                An AI R&D company applying signal processing and machine learning to healthcare,
                beginning with automated hearing diagnostics.
              </div>
              <div class="card__foot">About the research →</div>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------- TRAINING -->
    <section class="section">
      <div class="wrap rail">
        <h2 class="rail__label">Training</h2>
        <div>
          <p class="thesis__lead">I bring the work into the classroom.</p>
          <p class="training__body">
            Alongside university lectures, I run workshops on cybersecurity, applied AI, and
            AI governance for teams and decision-makers. The starting point is the problem
            your team needs to solve.
          </p>
          <div class="link-row">
            <a class="mono-link" href="/training/">Teaching & workshops →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ---------------------------------------------------- SELECTED TALKS -->
    <section class="section">
      <div class="wrap rail">
        <h2 class="rail__label">Selected talks</h2>
        <div>
          <div class="row-list">
            <div class="row row--top">
              <span class="row__title">
                FuseAI: a multi-agent system for penetration-testing automation
              </span>
              <span class="row__meta">The Hack Summit · 2025</span>
            </div>
            <div class="row">
              <span class="row__title">Cybersecurity: not only defence, but also attack</span>
              <span class="row__meta">CYBERSEC CEE · 2024</span>
            </div>
            <div class="row">
              <span class="row__title">Cyber offense in risk management</span>
              <span class="row__meta">AGH Cyber Kampus · 2023</span>
            </div>
          </div>
          <div class="link-row">
            <a class="mono-link" href="/speaking/">Talks, lectures & media →</a>
          </div>
        </div>
      </div>
    </section>
    <Contact />
  </main>
</Base>

<style>
  /* --- Thesis ------------------------------------------------------------- */
  .thesis {
    max-width: var(--prose);
  }

  .thesis__lead {
    margin: 0 0 26px;
    font-size: var(--size-lead);
    line-height: 1.34;
    letter-spacing: -0.018em;
    color: var(--ink-heading);
  }

  .thesis p {
    margin: 0 0 20px;
    color: var(--ink-body);
  }

  .thesis p.last {
    margin-bottom: 0;
  }

  .cta {
    display: inline-block;
    margin-top: 30px;
    font-family: var(--font-mono);
    font-size: var(--nav-size);
    letter-spacing: var(--nav-tracking);
    text-transform: uppercase;
    color: var(--ink);
    border-bottom: 1px solid var(--rule-accent);
    padding-bottom: 3px;
  }

  .cta:hover {
    color: var(--ink-bright);
    border-bottom-color: var(--ink-bright);
  }

  /* --- Essay rows --------------------------------------------------------- */
  .essay-row {
    display: flex;
    gap: 28px;
    align-items: baseline;
    border-top: 1px solid var(--rule);
    padding: 26px 0;
  }

  .essay-row:last-of-type {
    border-bottom: 1px solid var(--rule);
  }

  .essay-row:hover {
    background: rgba(237, 233, 225, 0.03);
  }

  .essay-row__body {
    flex: 1 1 auto;
  }

  .essay-row__title {
    font-size: var(--size-card-title);
    line-height: 1.28;
    letter-spacing: -0.018em;
    color: var(--ink-heading);
  }

  .essay-row__summary {
    margin-top: 8px;
    font-size: 15.5px;
    color: var(--ink-muted);
    max-width: 60ch;
  }

  .essay-row__date {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--nav-size);
    letter-spacing: 0.05em;
    color: var(--ink-faint);
  }

  .link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 26px;
    margin-top: 24px;
  }

  /* --- Research ----------------------------------------------------------- */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--rule);
    border: 1px solid var(--rule);
  }

  .stat {
    background: var(--surface);
    padding: 26px 24px;
  }

  .stat__n {
    font-family: var(--font-mono);
    font-size: 34px;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .stat__n span {
    font-size: 18px;
  }

  .stat__label {
    margin-top: 10px;
    font-size: 14px;
    color: var(--ink-muted);
    line-height: 1.45;
  }

  .research__note {
    margin: 26px 0 0;
    max-width: var(--prose);
    color: var(--ink-body);
  }

  .paper {
    margin-top: 22px;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }

  .paper__title {
    font-size: 16px;
    color: var(--ink);
    max-width: 76ch;
  }

  .paper__meta {
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: var(--nav-size);
    color: var(--ink-faint);
  }

  /* --- Venture cards ------------------------------------------------------ */
  .cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  .card {
    border: 1px solid var(--rule-strong);
    background: var(--surface);
    padding: 26px 24px 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 220px;
  }

  .card:hover {
    border-color: var(--ink);
    background: var(--surface-hover);
  }

  .card__role {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .card__name {
    font-size: 23px;
    letter-spacing: -0.02em;
    color: var(--ink-heading);
  }

  .card__body {
    font-size: 14.5px;
    color: var(--ink-muted);
    line-height: 1.5;
    flex: 1 1 auto;
  }

  .card__foot {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-faint);
  }

  /* --- Training teaser ---------------------------------------------------- */
  .training__body {
    margin: 0;
    max-width: var(--prose);
    color: var(--ink-body);
  }

  .row--top {
    border-top: 1px solid var(--rule);
  }

  /* --- Responsive --------------------------------------------------------- */
  @media (max-width: 900px) {
    .stats,
    .cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .thesis p.justify {
      text-align: left;
    }

    .essay-row {
      flex-direction: column;
      gap: 10px;
    }
  }
</style>
