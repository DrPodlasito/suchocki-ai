---
import Base from '../layouts/Base.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site';

const topics = [
  { id: 'ai-in-security', title: 'Applied AI', summary: 'How to use AI in everyday work, evaluate its output, and turn a promising experiment into a useful workflow.', points: ['AI for teams and decision-makers', 'Workflow design and automation', 'Data handling and limitations'] },
  { id: 'offensive-security', title: 'Offensive security', summary: 'Understanding how systems fail, testing their defences, and using the findings to reduce risk.', points: ['Penetration testing', 'Security of critical infrastructure and OT', 'AI in vulnerability management'] },
  { id: 'ai-governance', title: 'AI governance', summary: 'Connecting the technical behaviour of AI systems with the decisions, responsibilities, and controls around them.', points: ['ISO/IEC 42001', 'Risk assessment for AI systems', 'Responsible adoption of AI'] },
];
const lectures = [
  { university: 'WAT, Warsaw', subject: 'Cybersecurity; theory of computation and simulation' },
  { university: 'AGH, Kraków', subject: 'Penetration testing; security of critical infrastructure and OT' },
  { university: 'SGH, Warsaw', subject: 'AI in cybersecurity' },
];
---

<Base title={`Teaching & workshops — ${site.name}`} description="University teaching and workshops on applied AI, offensive security, and AI governance. In Polish and English.">
  <main id="main-content">
    <section class="wrap page">
      <div class="rail">
        <h2 class="rail__label">Teaching</h2>
        <div>
          <h1 class="page-title">From practice<br />to understanding.</h1>
          <p class="page-intro">I teach at WAT, AGH, and SGH, and run workshops for companies and leadership teams. The work starts with a question: what should your team be able to do differently afterwards?</p>
          <div class="topics">
            {topics.map((topic) => (
              <section class="topic" id={topic.id}>
                <h2>{topic.title}</h2>
                <p>{topic.summary}</p>
                <ul>{topic.points.map((point) => <li>{point}</li>)}</ul>
              </section>
            ))}
          </div>
          <section class="universities">
            <h2 class="group-head">University teaching</h2>
            {lectures.map((lecture) => (
              <div class="row"><span class="row__title">{lecture.university}</span><span class="lecture__subject">{lecture.subject}</span></div>
            ))}
          </section>
        </div>
      </div>
    </section>
    <Contact />
  </main>
</Base>

<style>
  .page { padding-block: 88px 60px; }
  .topics { margin-top: 52px; }
  .topic { padding: 30px 0; border-top: 1px solid var(--rule); }
  .topic h2 { font-size: 30px; font-weight: 500; line-height: 1.2; letter-spacing: -0.02em; margin: 0 0 16px; }
  .topic p { color: var(--ink-body); max-width: 58ch; }
  .topic ul { color: var(--ink-muted); padding-left: 20px; }
  .topic li { padding-block: 3px; }
  .universities { margin-top: 40px; }
  .group-head { margin: 0; font-weight: 400; }
  .lecture__subject { max-width: 38ch; color: var(--ink-muted); font-size: 15px; flex: 1; }
  @media (max-width: 900px) { .page { padding-block: 48px 32px; } }
</style>
