---
import type { Locale } from '../data/site';

interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const pauseLabel = lang === 'pl' ? 'Wstrzymaj animację' : 'Pause animation';
const resumeLabel = lang === 'pl' ? 'Wznów animację' : 'Resume animation';

// A fixed, layered topology. Each neuron connects to two in the next layer.
const layers = [
  { x: -50, ys: [80, 360, 690] },
  { x: 180, ys: [145, 360, 600, 830] },
  { x: 420, ys: [55, 245, 485, 720] },
  { x: 665, ys: [130, 340, 570, 815] },
  { x: 900, ys: [40, 240, 465, 700] },
  { x: 1140, ys: [120, 350, 585, 820] },
  { x: 1460, ys: [20, 260, 505, 750] },
].map(({ x, ys }) => ys.map((y) => ({ x, y })));

const edges = layers.slice(0, -1).flatMap((layer, layerIndex) => {
  const next = layers[layerIndex + 1];
  return layer.flatMap((node, nodeIndex) => {
    const nearest = Math.round(nodeIndex * (next.length - 1) / (layer.length - 1));
    const neighbour = nearest < next.length - 1 ? nearest + 1 : nearest - 1;
    return [nearest, neighbour].map((index) => {
      const target = next[index];
      const middle = (node.x + target.x) / 2;
      return `M ${node.x} ${node.y} C ${middle} ${node.y}, ${middle} ${target.y}, ${target.x} ${target.y}`;
    });
  });
});
const pulses = edges.filter((_, index) => index % 8 === 1);
---

<div class="neural-background" data-neural-network data-pause-label={pauseLabel} data-resume-label={resumeLabel}>
  <svg class="network" viewBox="0 0 1440 850" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="neural-visibility">
        <stop offset="0" stop-color="white" stop-opacity="0.12" />
        <stop offset="0.42" stop-color="white" stop-opacity="0.25" />
        <stop offset="0.72" stop-color="white" stop-opacity="0.9" />
        <stop offset="1" stop-color="white" stop-opacity="0.6" />
      </linearGradient>
      <mask id="neural-mask"><rect width="1440" height="850" fill="url(#neural-visibility)" /></mask>
    </defs>
    <g mask="url(#neural-mask)">
      <g class="network__connections">
        {edges.map((d) => <path d={d} />)}
      </g>
      <g class="network__nodes">
        {layers.flat().map(({ x, y }) => <circle cx={x} cy={y} r="2.5" />)}
      </g>
      <g class="network__signals">
        {pulses.map((d, index) => <path class="network__pulse" d={d} pathLength="100" style={`--delay: ${-index * 2.7}s; --duration: ${16 + index * 1.5}s`} />)}
      </g>
    </g>
  </svg>
  <button class="network__control" type="button" data-motion-control>
    <svg class="control-icon control-icon--pause" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M4 2v8M8 2v8" /></svg>
    <svg class="control-icon control-icon--play" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="m4 2 5 4-5 4Z" /></svg>
    <span data-motion-label>{pauseLabel}</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-neural-network]').forEach((root) => {
    const button = root.querySelector<HTMLButtonElement>('[data-motion-control]');
    const label = root.querySelector<HTMLElement>('[data-motion-label]');
    if (!button || !label) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let userPaused = false;
    let inView = false;

    const update = () => {
      root.dataset.motion = reducedMotion.matches
        ? 'reduced'
        : userPaused || document.hidden || !inView ? 'paused' : 'running';
    };

    button.addEventListener('click', () => {
      userPaused = !userPaused;
      root.dataset.userPaused = String(userPaused);
      label.textContent = (userPaused ? root.dataset.resumeLabel : root.dataset.pauseLabel) ?? '';
      update();
    });

    const visibility = new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      update();
    });
    visibility.observe(root);
    reducedMotion.addEventListener('change', update);
    document.addEventListener('visibilitychange', update);
    update();
  });
</script>

<style>
  .neural-background {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .network {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 0;
  }

  .network__connections {
    fill: none;
    stroke: #bac0bc;
    stroke-width: 0.8;
    stroke-opacity: 0.22;
  }

  .network__nodes { fill: #ede9e1; fill-opacity: 0.4; }
  .network__signals { fill: none; stroke: #ede9e1; stroke-width: 1.4; }
  .network__pulse { opacity: 0; stroke-linecap: round; stroke-dasharray: 4 196; }

  [data-motion='running'] .network__pulse,
  [data-motion='paused'] .network__pulse {
    opacity: 0.72;
    animation: transmission var(--duration) linear var(--delay) infinite;
    animation-play-state: paused;
  }

  [data-motion='running'] .network__pulse { animation-play-state: running; }

  .network__control {
    display: none;
    align-items: center;
    gap: 8px;
    position: absolute;
    z-index: 2;
    right: max(var(--gutter), calc((100% - var(--measure)) / 2 + var(--gutter)));
    bottom: 16px;
    min-height: 44px;
    padding: 8px 0 8px 12px;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--ink-faint);
    pointer-events: auto;
  }

  [data-motion='running'] .network__control,
  [data-motion='paused'] .network__control { display: inline-flex; }
  .network__control:hover { color: var(--ink); }
  .control-icon { fill: none; stroke: currentColor; stroke-width: 1.4; }
  .control-icon--play { display: none; }
  [data-user-paused='true'] .control-icon--pause { display: none; }
  [data-user-paused='true'] .control-icon--play { display: block; }

  @keyframes transmission {
    from { stroke-dashoffset: 200; }
    to { stroke-dashoffset: 0; }
  }

  @media (max-width: 700px) {
    .network { opacity: 0.55; }
    .network__control { bottom: 4px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .network__pulse, .network__control { display: none !important; }
  }
</style>
