---
import { site, links, type Locale } from '../data/site';
interface Props { lang?: Locale; }
const { lang = 'en' } = Astro.props;
const pl = lang === 'pl';
---

<section class="section contact" id={pl ? 'kontakt' : 'contact'}>
  <div class="wrap rail">
    <h2 class="rail__label">{pl ? 'Kontakt' : 'Contact'}</h2>
    <div>
      <p class="contact__lead">{pl ? 'Masz pomysł, pytanie lub zaproszenie?' : 'An idea, a question, or an invitation?'}</p>
      <p class="contact__copy">{pl ? 'Napisz do mnie w sprawie współpracy, wystąpienia lub szkolenia. Pracuję po polsku i angielsku, z Warszawy.' : 'Get in touch about a collaboration, a talk, or a workshop. I work in Polish and English, from Warsaw.'}</p>
      <div class="contact__links">
        <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="mono-link" href={links.linkedin} target="_blank" rel="me noopener">LinkedIn ↗</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__lead { margin: 0; font-size: var(--size-lead); line-height: 1.3; letter-spacing: -0.02em; }
  .contact__copy { max-width: 58ch; color: var(--ink-body); margin: 20px 0 26px; }
  .contact__links { display: flex; flex-wrap: wrap; gap: 16px 30px; align-items: center; }
  .contact__email { font-size: clamp(21px, 3vw, 34px); letter-spacing: -0.025em; border-bottom: 1px solid var(--rule-accent); }
  .contact__links a { display: inline-flex; min-height: 44px; align-items: center; }
</style>
